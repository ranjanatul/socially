<div class="header-wrapper">
  <header class="header">
    <div class="logo_wrapper">
      <span class="logo">
        <h1 style="color: #ee6a1f; background: black"> |S| </h1>
        <h1 class="logo_part"> ocially&nbsp;</h1>
        &nbsp;
      </span>
    </div>
    <navbar>
      <ul id="navbar">
        <li
          ><a id="home" href="/"> <i class="fa-solid fa-home icon"></i> </a
        ></li>
        <!-- locals.user we are using because locals is being passed via passport to the views so using just user in the first place will give error that user is not defined. -->
        <% if (locals.user) {%>
        <li>
          <a class="capitalize" id="profile" href="/user/profile">
            <i class="fa-solid fa-user icon"></i>
            <%- include('./utils/_tooltip', { data: user.name }) %>
          </a>
        </li>
        <li>
          <a class="capitalize" id="logout" href="/user/logout">
            <i class="fa-solid fa-sign-out-alt icon"></i>
            <%- include('./utils/_tooltip', { data: 'Logout' }) %>
          </a>
        </li>
        <% } else { %>
        <li
          ><a id="user" href="/user/auth">
            Join <%- include('./utils/_tooltip', { data: 'Register or login' })
            %>
          </a></li
        >
        <% } %>
      </ul>
    </navbar>
  </header>
  <hr />
  <div class="categories flex flex-sa">
    <div class="item"><a href="/rent">Rent</a></div>
    <div class="item"><a href="/buy">Sell</a></div>
    <div class="item"><a href="/sell">Buy</a></div>
  </div>
</div>
<%- include('_flashMsg'); %>
<script type="text/javascript" src="/js/header.js"></script>
