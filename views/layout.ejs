<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/layout.css" />

    <!-- Jquery -->

    <script type="text/javascript" src="/js/jquery.js"></script>

    <!-- fontawesome -->
    <script
      src="https://kit.fontawesome.com/3a855a35dc.js"
      crossorigin="anonymous"
    ></script>

    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"
      integrity="sha512-894YE6QWD5I59HgZOGReFYm4dnWc1Qt5NtvYSaNcOP+u1T9qYdvdihz0PPSiiqn/+/3e7Jo4EaG7TubfWGUrMQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <!-- inject the found link tags in body here -->
    <%- style %>

    <title>Socially - lets connect</title>
  </head>
  <body>
    <div class="wrapper">
      <div class="opac-layer vh-100">
        <div class="container vh-100">
          <!-- This is a partial where we are including some parts which is common to all the pages. -->
          <%- include('_header'); %>

          <!-- This is the body, which will render the part that controller will direct like home, profile etc. -->
          <main class="main-container"> <%- body %> </main>
          <!-- Again this is the partial -->
          <%- include('_footer'); %>
        </div>
      </div>
    </div>

    <!-- inject the script found in the body here -->
    <%- script %>
  </body>
</html>
